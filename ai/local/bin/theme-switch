#!/usr/bin/env bash
# theme-switch light|dark|toggle|auto
# TODO: rewrite ts to be shorter cuz im not reading allat
set -u
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}
state=$state_dir/theme
auto_state=$state_dir/theme-auto
backup=$state_dir/theme-backup
cfg=$HOME/.config
files=(
    alacritty/colors.toml kitty/current-theme.conf dunst/dunstrc
    rofi/colors.rasi rofi/this.rasi rofi/launcher.rasi eww/eww.scss bspwm/bspwmrc
)
mkdir -p "$state_dir"

# keep untouched copies of everything we edit, once
if [ ! -d "$backup" ]; then
    mkdir -p "$backup"
    for f in "${files[@]}" gtk-3.0/settings.ini gtk-4.0/settings.ini xsettingsd/xsettingsd.conf; do
        [ -f "$cfg/$f" ] && cp --parents "$cfg/$f" "$backup" 2>/dev/null
    done
fi

load() { # palette name -> assoc array via nameref
    local -n out=$2
    local k v
    while IFS== read -r k v; do
        [[ $k == [a-z]* ]] && out[$k]=${v//\"/}
    done < "$HOME/.local/palette-$1"
}

target=${1:-toggle}
case $target in
    toggle) [ "$(cat "$state" 2>/dev/null)" = light ] && target=dark || target=light ;;
    auto)
        period=$("$HOME/.local/bin/theme-sun")
        # act only when day/night actually changes, so a manual toggle sticks until the next sunrise/sunset
        [ "$(cat "$auto_state" 2>/dev/null)" = "$period" ] && exit 0
        echo "$period" > "$auto_state"
        target=$period ;;
    light|dark) ;;
    *) echo "usage: theme-switch light|dark|toggle|auto" >&2; exit 1 ;;
esac

[ "$target" = light ] && other=dark || other=light
declare -A from to
load "$other" from
load "$target" to

# every palette colour of the other theme -> the same colour of the target theme
sedargs=()
for k in "${!from[@]}"; do
    sedargs+=(-e "s/${from[$k]}/${to[$k]}/gI")
done
# edit copies, not the live files: alacritty and eww reload on write and would switch ahead of everything else
stage=$state_dir/theme-stage
for f in "${files[@]}"; do
    [ -f "$cfg/$f" ] || continue
    mkdir -p "$stage/${f%/*}"
    cp -p "$cfg/$f" "$stage/$f" && sed -i "${sedargs[@]}" "$stage/$f"
done

if [ "$target" = light ]; then
    wall=sunrise.png old_wall=sunset.png
else
    wall=sunset.png old_wall=sunrise.png
fi
sed -i "s/$old_wall/$wall/g" "$stage/bspwm/bspwmrc" "$HOME/.fehbg" 2>/dev/null

if [ "$target" = light ]; then
    gtk=Rosepine-Pink-Light icons=Colloid-Orange-Catppuccin-Light prefer=0 scheme=prefer-light
    cursor="GoogleDot Rose Pine Dawn"
else
    gtk=Rosepine-Pink-Dark icons=Colloid-Orange-Catppuccin-Dark prefer=1 scheme=prefer-dark
    cursor="GoogleDot Rose Pine"
fi
# theme names are prefixes of each other (and nwg-look may change them), so every key is rewritten whole
for f in gtk-3.0/settings.ini gtk-4.0/settings.ini; do
    [ -f "$cfg/$f" ] && sed -E -i \
        -e "s/^(gtk-theme-name=).*/\1$gtk/" \
        -e "s/^(gtk-icon-theme-name=).*/\1$icons/" \
        -e "s/^(gtk-application-prefer-dark-theme=).*/\1$prefer/" \
        -e "s/^(gtk-cursor-theme-name=).*/\1$cursor/" "$cfg/$f"
done
[ -f "$cfg/xsettingsd/xsettingsd.conf" ] && sed -E -i \
    -e "s/^(Net\/ThemeName ).*/\1\"$gtk\"/" \
    -e "s/^(Net\/IconThemeName ).*/\1\"$icons\"/" \
    -e "s/^(Gtk\/CursorThemeName ).*/\1\"$cursor\"/" "$cfg/xsettingsd/xsettingsd.conf"
sed -E -i "s/^( *icon_theme *= *).*/\1\"$icons\"/" "$cfg/dunst/dunstrc"
sed -E -i \
    -e "s/^(gtk-theme-name=).*/\1\"$gtk\"/" \
    -e "s/^(gtk-icon-theme-name=).*/\1\"$icons\"/" \
    -e "s/^(gtk-cursor-theme-name=).*/\1\"$cursor\"/" "$HOME/.gtkrc-2.0"
sed -E -i "s/^(Xcursor\.theme:).*/\1 $cursor/" "$HOME/.Xresources"
sed -E -i "s/^(Inherits=).*/\1$cursor/" "$HOME/.icons/default/index.theme"
# libadwaita ignores gtk-theme-name and only loads ~/.config/gtk-4.0/gtk.css, so point the links at the theme
gtk4=$HOME/.themes/$gtk/gtk-4.0
if [ -d "$gtk4" ]; then
    for l in assets gtk.css gtk-dark.css; do
        ln -sfn "$gtk4/$l" "$cfg/gtk-4.0/$l"
    done
fi

echo "$target" > "$state"

# swap every edited file in at once, then fire all reloads together, so apps switch in one go, not one by one
for f in "${files[@]}"; do
    [ -f "$stage/$f" ] && mv -f "$stage/$f" "$cfg/$f"
done
# one dconf write instead of four gsettings calls: each call was a separate portal signal and a separate repaint
dconf load / 2>/dev/null <<EOF &
[org/gnome/desktop/interface]
color-scheme='$scheme'
gtk-theme='$gtk'
icon-theme='$icons'
cursor-theme='$cursor'
EOF
pkill -HUP -x xsettingsd
pkill -USR1 -x kitty
{ xrdb -merge "$HOME/.Xresources"; xsetroot -cursor_name left_ptr; } &
feh --no-fehbg --bg-scale "$HOME/$wall" 2>/dev/null &
dunstctl reload 2>/dev/null &
eww reload 2>/dev/null &
bspc config focused_border_color "${to[rose]}" 2>/dev/null &
bspc config normal_border_color "${to[overlay]}" 2>/dev/null &
wait
exit 0
