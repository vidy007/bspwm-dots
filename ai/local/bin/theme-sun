#!/usr/bin/env python3
"""Print 'light' between sunrise and sunset at LAT, LON, otherwise 'dark' (NOAA approximation)."""
import math
from datetime import datetime, timezone

LAT, LON = 40.71, -74.01  # New York; set yours (south latitude and west longitude are negative)

now = datetime.now(timezone.utc)
g = 2 * math.pi / 365 * (now.timetuple().tm_yday - 1)
eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                   - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g)
        - 0.006758 * math.cos(2 * g) + 0.000907 * math.sin(2 * g)
        - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
lat = math.radians(LAT)
c = math.cos(math.radians(90.833)) / (math.cos(lat) * math.cos(decl)) - math.tan(lat) * math.tan(decl)
ha = math.degrees(math.acos(max(-1.0, min(1.0, c))))

# minutes since 00:00 UTC; may fall outside 0..1440 for our longitude
sunrise = 720 - 4 * (LON + ha) - eqtime
sunset = 720 - 4 * (LON - ha) - eqtime
t = now.hour * 60 + now.minute
day = any(sunrise + o <= t < sunset + o for o in (-1440, 0, 1440))
print("light" if day else "dark")
