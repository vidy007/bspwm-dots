(defwidget bar [screen]
  (centerbox :orientation "v"
    (box :class "segment-top"
         :valign "start"
      (top :screen screen))
    (box :valign "center"
         :class "middle"
      (middle :screen screen))
    (box :valign "end"
         :class "segment-bottom"
      (bottom :screen screen))))

(defwidget kbd []
       (box :class "kbd-metric"
       :orientation "v"
       :space-evenly false
       :valign "fill"
       :vexpand false
       :hexpand false
       (box :orientation "v"
           :valign "fill"
           :vexpand true
	   (label :text " ")
       	   (label :text layout))))

(defwidget top [screen]
  (box :orientation "v"
    (bspwm_desktops)
    (systray :orientation "v" :icon-size "17")
    ))

(defwidget bspwm_desktops []
  (box
    :class "workspaces"
    :spacing 6
    :orientation "v"

    (button
      :class {focused_desktop == "cmd" ? "workspace-dot active" : "workspace-dot"}
      :onclick "bspc desktop -f cmd"
      "●")

    (button
      :class {focused_desktop == "web" ? "workspace-dot active" : "workspace-dot"}
      :onclick "bspc desktop -f web"
      "●")

    (button
      :class {focused_desktop == "etc" ? "workspace-dot active" : "workspace-dot"}
      :onclick "bspc desktop -f etc"
      "●")))

(defwidget middle [] (time))
(defwidget time []
  (box :orientation "v"
       :class "time"
    {tick.hour} {tick.min}))

(defwidget metric [icon ?font-size]
  (box :class "metric"
       :orientation "v"
    (label :class "metric-icon"
           :style {font-size != "" ? "font-size: ${font-size}rem;" : ""}
           :text icon)
    (children)))

(defwidget bottom [screen]
  (box :orientation "v"
       :valign "end"
       :space-evenly false
       :spacing "5"

    (kbd)
    (volume)
    (battery-metric)
    (box :class "metric" (date))))

(defwidget volume []
  (box :class "volume-metric"
       :orientation "v"
       :space-evenly false
       :valign "fill"
       :vexpand false
       :hexpand false
    (scale :orientation "h"
           :min 0
           :max 100
           :onchange "pamixer --set-volume $(echo {} | sed 's/\\..*//g')"
           :value volume)
    (box :vexpand true)
    (eventbox :onscroll "if [ '{}' == 'up' ]; then pamixer -i 5; else pamixer -d 5; fi"
              :vexpand true
              :valign "fill"
      (box :orientation "v"
           :valign "fill"
           :vexpand false
          (label :class "volicon" :text "  ")
        (button :onclick "pavucontrol &"
          volume)))))

(defwidget large-sym [sym]
  (label :class "metric-icon large-symbol" :text sym))

(defwidget battery-metric []
	(box :class "battery"
	     :orientation "v"
	     :valign "fill"
	     :vexpand false
	     (label :class "batteryicon" :text {battery.icon})
	     (label :text {battery.bat})
	)
)

(defwidget date []
  (box :orientation "v"
       :halign "center"
    {tick.wday} {tick.mon} {tick.day} {tick.year}))

(deflisten focused_desktop
  :initial "1"
  "~/.config/eww/scripts/bspwm-desktops.sh")
(deflisten volume :initial "0" "~/.config/eww/scripts/audio.sh volume")
(deflisten layout "~/.config/eww/scripts/layout.sh")
(deflisten tick :initial "{}" "~/.config/eww/scripts/tick.sh")
(deflisten battery :initial "{}" "~/.config/eww/scripts/battery.sh")

(defwindow bar_1
  :monitor "eDP1"
  :stacking "fg"
  :geometry (geometry :x 0 :y 0 :width "44px" :height "100%" :anchor "center left")
  :reserve (struts :distance "44px" :side "left")
  :exclusive true
  (bar :screen 1))
